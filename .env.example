# Celo mainnet RPC (default: https://forno.celo.org)
# CELO_RPC_URL=https://forno.celo.org

# Ethereum RPC for ENS resolution (optional)
# ETH_RPC_URL_MAINNET=https://ethereum.publicnode.com

# Supabase (required for GET /offchain/* — same project as celina-stats-api)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
